{
    "name": "@rat.md/miru.at",
    "description": "The VitePress documentation, component showcase and playground for miru.",
    "private": true,
    "license": "MIT",
    "author": "rat.md",
    "homepage": "https://miru.at",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RatMD/miru.at.git"
    },
    "bugs": {
        "url": "https://github.com/RatMD/miru.at/issues"
    },
    "type": "module",
    "scripts": {
        "build": "npm run docs:sync && vitepress build",
        "dev": "npm run docs:sync && vitepress dev",
        "docs:sync": "node scripts/prepare-package.mjs && node scripts/sync-brand.mjs && node scripts/generate-api.mjs && node scripts/sync-docs.mjs",
        "docs:storybook": "node scripts/prepare-package.mjs && node scripts/sync-storybook.mjs",
        "format": "prettier --check .vitepress/config.mts .vitepress/seo.ts .vitepress/theme scripts tests",
        "format:fix": "prettier --write .vitepress/config.mts .vitepress/seo.ts .vitepress/theme scripts tests",
        "lint": "eslint .vitepress scripts tests --max-warnings 0",
        "lint:fix": "eslint .vitepress scripts tests --fix --max-warnings 0",
        "preview": "vitepress preview",
        "seo:check": "node scripts/check-seo.mjs",
        "test": "node --test tests/*.test.mjs",
        "test:docs": "node --test tests/docs.test.mjs && node scripts/check-examples.mjs",
        "typecheck": "node ../package/node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.json",
        "prepare": "node scripts/install-hooks.mjs",
        "check": "npm run docs:sync && npm run lint && npm run typecheck && npm test && node scripts/check-examples.mjs"
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-vue": "^0.1.3",
        "@codemirror/language": "^6.13.1",
        "@codemirror/legacy-modes": "^6.5.5",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@rat.md/miru": "file:../package",
        "@tabler/icons-vue": "^3.52.0",
        "@vue/compiler-sfc": "^3.5.46",
        "codemirror": "^6.0.2",
        "sucrase": "^3.35.1",
        "vue": "^3.5.46",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^24.19.4",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-vue": "^10.12.1",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "prettier": "^3.10.1",
        "typescript": "^6.0.2",
        "vitepress": "^2.0.0-alpha.21"
    }
}
